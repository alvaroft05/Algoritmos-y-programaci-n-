Algoritmo Ejercicio3_6H
	
	Definir A, B, C, D Como Entero;
	
	Escribir "Introduzca el valor de X1"
	Leer A;
	
	Escribir "Introduzca el valor de X2"
	Leer B;
	
	Escribir "Introduzca el valor de Y1"
	Leer C;
	
	Escribir "Introduzca el valor de Y2"
	Leer D;
	
	Escribir (B - A) ^ 2 + (D - C)
	
FinAlgoritmo
