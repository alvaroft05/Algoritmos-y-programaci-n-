Algoritmo CON02
	
	Definir N1, N2, N3 Como Enteros;
	
	Escribir "Introduzca numero";
	Leer N1
	Escribir "Introduzca numero";
	Leer N2
	Escribir "Introduzca numero";
	Leer N3
	
	Si N2 > N1 y N3 > N2 Entonces
		
		Escribir "Los numeros estan ordenados de forma ascendente"
	Sino
		
		Escribir "Los numeros no estan ordenados de forma ascendente"
		
	FinSi
	
FinAlgoritmo
