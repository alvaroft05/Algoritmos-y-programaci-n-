Algoritmo CON8
	
	Definir Calificacion Como Entero
	
	Escribir "Introduzca una Calificacion del 1 al 5"
	Leer Calificacion
	
	Segun Calificacion Hacer
		1: Escribir "A"
		2: Escribir "B"
		3: Escribir "C"
		4: Escribir "D"
		5: Escribir "E"
		De Otro Modo:
			Escribir "El numero tiene que ser del 1 al 5"
	FinSegun
	
FinAlgoritmo
