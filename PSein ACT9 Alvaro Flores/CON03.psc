Algoritmo CON03
	// AlvaroAlfredo 00589547
	Definir Numero Como Entero;
	
	Escribir "Introduzca el numero entero";
	Leer Numero;
	
	Si Numero % 5 = 0 Entonces;
		
		Escribir "El numero es multiplo de 5";
		
	SiNo;
		
		Escribir "El numero no es multiplo de 5";
	FinSi;
	
FinAlgoritmo

