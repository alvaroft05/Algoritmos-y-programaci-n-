Algoritmo SEC04
	Definir A, B Como Real
	Definir f, g, c, d, e Como Real
	Escribir ' Introduzca un numero '
	Leer A
	Escribir ' Introduzca un numero '
	Leer B
	f <- A+B
	g <- A-B
	c <- A*B
	d <- A/B
	e <- f+g+c+d
	Escribir ' La suma es: ', f
	Escribir ' La resta es: ', g
	Escribir ' La multiplicacion es: ', c
	Escribir ' La division es; ', d
	Escribir ' La suma total es ', e
FinAlgoritmo
