Algoritmo REP10
	// AlvaroAlfredo 00589547
	Definir Suma Como Real;
	Definir i Como Entero;
	
	Para I <- 1 Hasta 200 Hacer
		Suma <- Suma + I
	FinPara
	Escribir "La suma de los numeros pares e impares del 1 al 100 es de: ", Suma
	Escribir "La Media de la suma de los numero pares e impares del 1 al 100 es de: ", Suma / 2
	

	
	
FinAlgoritmo

